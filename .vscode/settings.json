{
  // Only show the python-libs repo in Source Control: don't pick up repos
  // from files opened outside this folder, or from parent folders.
  "git.autoRepositoryDetection": "subFolders",
  "git.openRepositoryInParentFolders": "never",

  // Let Git Credential Manager supply the GitHub token instead of VS Code's
  // own GitHub sign-in, which asks which account to use.
  "github.gitAuthentication": false,

  "python.terminal.activateEnvInTerminal": true,
  "terminal.integrated.env.windows": { "PYTHONDONTWRITEBYTECODE": "1" },
  "terminal.integrated.env.osx": { "PYTHONDONTWRITEBYTECODE": "1" },
  "terminal.integrated.env.linux": { "PYTHONDONTWRITEBYTECODE": "1" },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true
  },
  "files.watcherExclude": {
    "**/__pycache__/**": true
  }
}
